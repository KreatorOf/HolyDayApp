default_platform(:ios)

APP_ID    = "com.matthiascadet.HolyDay"
WIDGET_ID = "com.matthiascadet.HolyDay.HolyDayWidget"
XCODEPROJ = "HolyDay.xcodeproj"

# « Ce qu'il faut tester » envoyé aux testeurs TestFlight (interne comme externe).
# Distinct des notes App Store (metadata/<langue>/release_notes.txt), qui s'adressent au public.
TESTFLIGHT_NOTES = "fastlane/testflight_whats_new.txt"

platform :ios do

  # Sur CI, match importe le certificat dans le trousseau de session sans pouvoir poser la
  # « key partition list » (pas de mot de passe de trousseau). codesign lève alors une demande
  # d'autorisation graphique que personne ne peut valider sur un runner headless, et le build
  # gèle indéfiniment à la signature (observé sur HolyDayWidgetExtension.appex).
  # `setup_ci` crée un trousseau temporaire dédié et évite ce blocage.
  before_all do
    setup_ci if ENV["CI"]
  end

  # =====================================================================================
  #  Lanes — trois verbes, un par destination
  #
  #    fastlane beta            build neuf  -> TestFlight (testeurs internes)
  #    fastlane beta_external   build neuf  -> TestFlight externe + Beta App Review
  #    fastlane release         AUCUN build -> promeut vers l'App Store le build déjà testé
  #    fastlane screenshots     captures d'écran App Store
  #
  #  Le point important : `release` ne recompile jamais. On soumet exactement le binaire qui
  #  est passé par TestFlight, pas un jumeau reconstruit juste après la recette.
  # =====================================================================================

  desc "Build et envoi sur TestFlight (testeurs internes)"
  lane :beta do
    build_release
    upload_to_testflight(
      api_key: asc_api_key,
      changelog: testflight_notes_text,
      skip_waiting_for_build_processing: true
    )
    UI.success("Build #{lane_context[SharedValues::BUILD_NUMBER]} envoyé sur TestFlight.")
    UI.message("Une fois testé : `bundle exec fastlane release` (promotion, sans recompilation).")
  end

  desc "Build et envoi en beta externe (passe par la Beta App Review)"
  lane :beta_external do
    build_release

    upload_to_testflight(
      api_key: asc_api_key,
      distribute_external: true,
      notify_external_testers: true,
      groups: ["HolyDay Beta"],
      submit_beta_review: true,
      changelog: testflight_notes_text,
      # La review externe exige un build « processed » : on attend, contrairement à la lane interne.
      skip_waiting_for_build_processing: false,

      beta_app_review_info: {
        contact_email: "matthias.cadet25+betaholyday@gmail.com",
        contact_first_name: "Matthias",
        contact_last_name: "Cadet",
        contact_phone: "+33613395971",
        notes: "App de journal de prière. Aucun compte requis, pas de login. " \
               "Toutes les fonctionnalités sont accessibles directement. " \
               "Les dons RevenueCat sont optionnels et ne déverrouillent rien."
      },

      localized_app_info: {
        "default" => beta_app_info(:fr),
        "fr-FR"   => beta_app_info(:fr),
        "en-US"   => beta_app_info(:en)
      }
    )
  end

  desc "Promeut vers l'App Store le dernier build TestFlight (ne recompile pas). " \
       "`submit:true` pour envoyer aussi en review."
  lane :release do |options|
    key = asc_api_key
    version = get_version_number(xcodeproj: XCODEPROJ, target: "HolyDay")
    build = latest_testflight_build_number(api_key: key, app_identifier: APP_ID, version: version)

    if build.to_i.zero?
      UI.user_error!(
        "Aucun build TestFlight pour la version #{version}. " \
        "Lance d'abord `bundle exec fastlane beta`."
      )
    end

    UI.important("Promotion du build #{build} (version #{version}) — sans recompilation.")

    upload_to_app_store(
      api_key: key,
      app_version: version,
      build_number: build.to_s,
      # Le cœur de la lane : on ne téléverse aucun binaire, on désigne celui déjà sur TestFlight.
      skip_binary_upload: true,
      # Le dépôt ne versionne aucune capture (fastlane/screenshots est vide) : par défaut on laisse
      # intactes celles déjà en ligne. Pour les remplacer : `fastlane screenshots` puis
      # `fastlane release screenshots:true`.
      skip_screenshots: !options.fetch(:screenshots, false),
      # Par sécurité, ne soumet pas à la review sans le demander explicitement.
      submit_for_review: options.fetch(:submit, false),
      # La mise en vente reste déclenchée à la main après approbation.
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      metadata_path: "./fastlane/metadata",
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )

    if options.fetch(:submit, false)
      UI.success("Version #{version} (build #{build}) soumise à la review.")
    else
      UI.success("Version #{version} (build #{build}) préparée sur App Store Connect.")
      UI.message("Relis la fiche, puis `bundle exec fastlane release submit:true`.")
    end
  end

  # Convention de nommage : les lanes portent un verbe (`update_...`), les helpers portent la valeur
  # qu'ils renvoient (`..._text`). Une lane et un helper homonymes se confondent silencieusement à
  # l'appel — `changelog: testflight_notes` invoquait la lane, qui renvoie `true`.
  desc "Met à jour le « ce qu'il faut tester » du dernier build TestFlight, sans recompiler"
  lane :update_testflight_notes do
    key = asc_api_key
    version = get_version_number(xcodeproj: XCODEPROJ, target: "HolyDay")
    build = latest_testflight_build_number(api_key: key, app_identifier: APP_ID, version: version)

    if build.to_i.zero?
      UI.user_error!("Aucun build TestFlight pour la version #{version}.")
    end

    # App Store Connect refuse certains caractères dans ce champ (les filets « ━ » notamment) :
    # une faute ici faisait échouer toute la lane `beta` APRÈS l'upload du binaire. Cette lane
    # permet de corriger le texte seul, sans reconstruire ni renuméroter quoi que ce soit.
    #
    # `distribute_only` est l'option de pilot pour agir sur un build déjà en ligne — l'équivalent
    # de `skip_binary_upload` côté deliver, qui n'existe pas ici (erreur facile à faire : les deux
    # actions ont des jeux d'options distincts).
    upload_to_testflight(
      api_key: key,
      app_identifier: APP_ID,
      app_version: version,
      build_number: build.to_s,
      distribute_only: true,
      changelog: testflight_notes_text
    )

    UI.success("Notes de test mises à jour sur le build #{build} (version #{version}).")
  end

  desc "Captures d'écran App Store (cible HolyDayUITests, config fastlane/Snapfile)"
  lane :screenshots do
    capture_screenshots
  end

  # =====================================================================================
  #  Interne
  # =====================================================================================

  # Signature + numérotation + archive. Utilisée par les deux lanes de beta uniquement :
  # `release` ne construit rien.
  private_lane :build_release do
    key = asc_api_key

    match(
      type: "appstore",
      app_identifier: [APP_ID, WIDGET_ID],
      readonly: true
    )

    # build_configurations limité à Release : sans ce filtre l'action écrit aussi dans Debug, ce qui
    # casse les builds sur device depuis Xcode (un profil AppStore n'autorise pas l'installation
    # directe). Le scheme archive en Release.
    update_code_signing_settings(
      use_automatic_signing: false,
      targets: ["HolyDay"],
      build_configurations: ["Release"],
      bundle_identifier: APP_ID,
      profile_name: "match AppStore #{APP_ID}",
      code_sign_identity: "Apple Distribution"
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      targets: ["HolyDayWidgetExtension"],
      build_configurations: ["Release"],
      bundle_identifier: WIDGET_ID,
      profile_name: "match AppStore #{WIDGET_ID}",
      code_sign_identity: "Apple Distribution"
    )

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: key) + 1
    )

    build_app(
      scheme: "HolyDay",
      export_method: "app-store"
    )
  end

  # Mémoïsée : sans ça chaque lane recréait la clé deux ou trois fois par exécution.
  def asc_api_key
    @asc_api_key ||= app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"]
    )
  end

  # « Ce qu'il faut tester », lu depuis un fichier pour ne pas vivre en dur dans le Fastfile —
  # c'est la partie qui change à chaque version. Repli sur les notes App Store françaises.
  def testflight_notes_text
    path = File.expand_path("../#{TESTFLIGHT_NOTES}", __dir__)
    return File.read(path).strip if File.exist?(path)

    fallback = File.expand_path("../fastlane/metadata/fr-FR/release_notes.txt", __dir__)
    return File.read(fallback).strip if File.exist?(fallback)

    UI.important("Aucune note de test trouvée (#{TESTFLIGHT_NOTES}).")
    nil
  end

  def beta_app_info(locale)
    common = {
      feedback_email: "matthias.cadet25+betaholydayfeedback@gmail.com",
      marketing_url: "https://holyday-landing.vercel.app/index.html",
      privacy_policy_url: "https://holyday-landing.vercel.app/privacy.html"
    }

    if locale == :en
      common.merge(
        description: "Daily prayer journal: mood check-in with a matching Bible verse " \
                     "(Berean Standard Bible), ACTS guided prayer, free prayer and a prayer journal."
      )
    else
      common.merge(
        description: "Journal de prière quotidien : check-in d'humeur et verset en lien avec " \
                     "l'humeur (Louis Segond 1910), prière guidée ACTS ou libre, et journal de prières."
      )
    end
  end
end
