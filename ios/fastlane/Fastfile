default_platform(:ios)

APP_ID    = "com.matthiascadet.HolyDay"
XCODEPROJ = "HolyDay.xcodeproj"

# « Ce qu'il faut tester » envoyé aux testeurs TestFlight.
# Xcode Cloud lit lui-même ce dossier (`TestFlight/WhatToTest.<locale>.txt`, à côté du
# .xcodeproj) et joint les notes au build qu'il distribue. Les lanes ci-dessous lisent le
# même fichier : une seule source de vérité, qu'on passe par Xcode Cloud ou par fastlane.
# Distinct des notes App Store (metadata/<langue>/release_notes.txt), qui s'adressent au public.
TESTFLIGHT_NOTES = "TestFlight/WhatToTest.fr-FR.txt"

platform :ios do

  # =====================================================================================
  #  Lanes — aucune ne compile quoi que ce soit.
  #
  #  Depuis le passage à Xcode Cloud, le seul producteur de binaires est Xcode Cloud :
  #  un push sur `main` lint, teste, archive et dépose sur TestFlight. fastlane ne sert
  #  plus qu'à ce qu'Xcode Cloud ne sait pas faire — la fiche App Store et la review.
  #
  #    fastlane beta_external        distribue le build TestFlight courant en beta externe
  #    fastlane release              promeut ce même build vers l'App Store
  #    fastlane update_testflight_notes  corrige le « ce qu'il faut tester »
  #    fastlane screenshots          captures d'écran App Store
  #
  #  Le point important : on soumet exactement le binaire qui est passé par TestFlight,
  #  jamais un jumeau reconstruit après la recette.
  # =====================================================================================

  desc "Distribue le dernier build TestFlight aux testeurs externes (passe par la Beta App Review)"
  lane :beta_external do
    key = asc_api_key
    build = current_testflight_build(key)

    upload_to_testflight(
      api_key: key,
      app_identifier: APP_ID,
      app_version: current_version,
      build_number: build.to_s,
      # Équivalent de `skip_binary_upload` côté deliver : on agit sur un build déjà en ligne
      # (celui d'Xcode Cloud) au lieu d'en téléverser un nouveau. Erreur facile à faire :
      # les deux actions ont des jeux d'options distincts.
      distribute_only: true,
      distribute_external: true,
      notify_external_testers: true,
      groups: ["HolyDay Beta"],
      submit_beta_review: true,
      changelog: testflight_notes_text,

      beta_app_review_info: {
        contact_email: "matthias.cadet25+betaholyday@gmail.com",
        contact_first_name: "Matthias",
        contact_last_name: "Cadet",
        contact_phone: "+33613395971",
        notes: "App de journal de prière. Aucun compte requis, pas de login. " \
               "Toutes les fonctionnalités sont accessibles directement. " \
               "Les dons RevenueCat sont optionnels et ne déverrouillent rien."
      },

      localized_app_info: {
        "default" => beta_app_info(:fr),
        "fr-FR"   => beta_app_info(:fr),
        "en-US"   => beta_app_info(:en)
      }
    )

    UI.success("Build #{build} distribué en beta externe.")
  end

  desc "Promeut vers l'App Store le dernier build TestFlight (ne recompile pas). " \
       "`submit:true` pour envoyer aussi en review."
  lane :release do |options|
    key = asc_api_key
    version = current_version
    build = current_testflight_build(key)

    UI.important("Promotion du build #{build} (version #{version}) — sans recompilation.")

    upload_to_app_store(
      api_key: key,
      app_version: version,
      build_number: build.to_s,
      # Le cœur de la lane : on ne téléverse aucun binaire, on désigne celui déjà sur TestFlight.
      skip_binary_upload: true,
      # Le dépôt ne versionne aucune capture (fastlane/screenshots est vide) : par défaut on laisse
      # intactes celles déjà en ligne. Pour les remplacer : `fastlane screenshots` puis
      # `fastlane release screenshots:true`.
      skip_screenshots: !options.fetch(:screenshots, false),
      # Par sécurité, ne soumet pas à la review sans le demander explicitement.
      submit_for_review: options.fetch(:submit, false),
      # La mise en vente reste déclenchée à la main après approbation.
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      metadata_path: "./fastlane/metadata",
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )

    if options.fetch(:submit, false)
      UI.success("Version #{version} (build #{build}) soumise à la review.")
    else
      UI.success("Version #{version} (build #{build}) préparée sur App Store Connect.")
      UI.message("Relis la fiche, puis `bundle exec fastlane release submit:true`.")
    end
  end

  # Convention de nommage : les lanes portent un verbe (`update_...`), les helpers portent la valeur
  # qu'ils renvoient (`..._text`). Une lane et un helper homonymes se confondent silencieusement à
  # l'appel — `changelog: testflight_notes` invoquait la lane, qui renvoie `true`.
  desc "Met à jour le « ce qu'il faut tester » du dernier build TestFlight, sans recompiler"
  lane :update_testflight_notes do
    key = asc_api_key
    version = current_version
    build = current_testflight_build(key)

    # App Store Connect refuse certains caractères dans ce champ (les filets « ━ » notamment).
    # Xcode Cloud, lui, joint les notes au moment de la distribution : une faute de frappe y
    # laisserait un build correct avec des notes fausses. Cette lane corrige le texte seul,
    # sans reconstruire ni renuméroter quoi que ce soit.
    upload_to_testflight(
      api_key: key,
      app_identifier: APP_ID,
      app_version: version,
      build_number: build.to_s,
      distribute_only: true,
      changelog: testflight_notes_text
    )

    UI.success("Notes de test mises à jour sur le build #{build} (version #{version}).")
  end

  desc "Captures d'écran App Store (cible HolyDayUITests, config fastlane/Snapfile)"
  lane :screenshots do
    capture_screenshots
  end

  # =====================================================================================
  #  Interne
  # =====================================================================================

  # Mémoïsée : sans ça chaque lane recréait la clé deux ou trois fois par exécution.
  def asc_api_key
    @asc_api_key ||= app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"]
    )
  end

  def current_version
    get_version_number(xcodeproj: XCODEPROJ, target: "HolyDay")
  end

  # Le numéro de build n'est plus décidé ici : c'est celui qu'Xcode Cloud a attribué à son
  # archive. Toutes les lanes désignent donc le dernier build en ligne pour la version courante.
  def current_testflight_build(key)
    version = current_version
    build = latest_testflight_build_number(api_key: key, app_identifier: APP_ID, version: version)

    if build.to_i.zero?
      UI.user_error!(
        "Aucun build TestFlight pour la version #{version}. " \
        "Pousse sur `main` (ou lance le workflow Xcode Cloud à la main) et attends l'archive."
      )
    end

    build
  end

  # « Ce qu'il faut tester », lu depuis le dossier TestFlight/ pour ne pas vivre en dur dans le
  # Fastfile — c'est la partie qui change à chaque version. Repli sur les notes App Store.
  def testflight_notes_text
    path = File.expand_path("../#{TESTFLIGHT_NOTES}", __dir__)
    return File.read(path).strip if File.exist?(path)

    fallback = File.expand_path("../fastlane/metadata/fr-FR/release_notes.txt", __dir__)
    return File.read(fallback).strip if File.exist?(fallback)

    UI.important("Aucune note de test trouvée (#{TESTFLIGHT_NOTES}).")
    nil
  end

  def beta_app_info(locale)
    common = {
      feedback_email: "matthias.cadet25+betaholydayfeedback@gmail.com",
      marketing_url: "https://holyday-landing.vercel.app/index.html",
      privacy_policy_url: "https://holyday-landing.vercel.app/privacy.html"
    }

    if locale == :en
      common.merge(
        description: "Daily prayer journal: mood check-in with a matching Bible verse " \
                     "(Berean Standard Bible), ACTS guided prayer, free prayer and a prayer journal."
      )
    else
      common.merge(
        description: "Journal de prière quotidien : check-in d'humeur et verset en lien avec " \
                     "l'humeur (Louis Segond 1910), prière guidée ACTS ou libre, et journal de prières."
      )
    end
  end
end
